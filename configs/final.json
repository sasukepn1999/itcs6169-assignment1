{
  "experiment": "final_recipe",
  "seeds": [
    0,
    1,
    2
  ],
  "description": "Final submission model: ImageNet-pretrained EfficientNet-B0, supervised on train+val+test, FixMatch on unlabelled test2. No held-out data.",
  "config": {
    "model": "efficientnet_b0",
    "img_size": 200,
    "augment": [
      "hflip",
      "rrc",
      "translate"
    ],
    "schedule": "cosine",
    "epochs": 200,
    "amp": true,
    "pretrained": true,
    "lr": 0.0001,
    "ssl": "fixmatch",
    "ssl_weight": 1.0,
    "ssl_source": "test2",
    "fixmatch_tau": 0.95,
    "train_on": "all"
  }
}
